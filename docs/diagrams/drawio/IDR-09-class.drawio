<mxfile host="drawio" agent="csit314-diagram-generator" version="24.7.17"><diagram id="IDR-09-class" name="IDR-09-class"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value='&lt;b style="font-size:16px"&gt;IDR-09 · Track project milestones — Class Diagram&lt;/b&gt;&lt;br&gt;&lt;i&gt;As an Interior Designer, I want to track project milestones (design approved, materials ordered, installation complete) so customers can follow progress on their renovation.&lt;/i&gt;&lt;br&gt;&lt;span style="color:#555555"&gt;Layers: «Boundary» = Spring @Controller · «Control» = @Service · «Entity» = JPA entity / repository / data record&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1218" height="70" as="geometry"/></mxCell><mxCell id="c4" value='&lt;div style="text-align:center"&gt;«Boundary»&lt;br&gt;&lt;b style="font-size:13px"&gt;DesignerController&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- projectService: ProjectService&lt;br&gt;- designerService: DesignerService&lt;br&gt;- loginSession: LoginSession&lt;hr&gt;+ advanceMilestone(id: Long, request: HttpServletRequest,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;redirect: RedirectAttributes): String&lt;br&gt;+ dashboard(request: HttpServletRequest, model: Model): String' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="196" y="110" width="393" height="152" as="geometry"/></mxCell><mxCell id="c5" value='&lt;div style="text-align:center"&gt;«Boundary»&lt;br&gt;&lt;b style="font-size:13px"&gt;PageCon