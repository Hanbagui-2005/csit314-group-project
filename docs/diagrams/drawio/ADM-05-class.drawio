<mxfile host="drawio" agent="csit314-diagram-generator" version="24.7.17"><diagram id="ADM-05-class" name="ADM-05-class"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b style=&quot;font-size:16px&quot;&gt;ADM-05 · Verify designer licence — Class Diagram&lt;/b&gt;&lt;br&gt;&lt;i&gt;As a User Admin, I want to verify a designer's business registration or license number against the details they provide so fraudulent companies can't get listed.&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;Layers: «Boundary» = Spring @Controller · «Control» = @Service · «Entity» = JPA entity / repository / data record&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1446" height="70" as="geometry"/></mxCell><mxCell id="c4" value='&lt;div style="text-align:center"&gt;«Boundary»&lt;br&gt;&lt;b style="font-size:13px"&gt;AdminController&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- designerService: DesignerService&lt;br&gt;- licenseVerificationService: LicenseVerificationService&lt;br&gt;- loginSession: LoginSession&lt;hr&gt;+ license(id: Long, model: Model, redirect: RedirectAttributes): String&lt;br&gt;+ verifyLicense(id: Long, licenseNumber: String, companyName: String,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;note: String, request: HttpServletRequest,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;redirect: RedirectAttributes): String&lt;br&gt;+ revokeLicense(id: Long, licenseNumber: String, companyName: String,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;note: String, request: HttpServletRequest,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;redirect: RedirectAttributes): String' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="526" y="110" width="434" height="206" as="geometry"/></mxCell><mxCell id="c5" value='&lt;div style="text-align:center"&gt;«Control»&lt;br&gt;&lt;b style="font-size:13px"&gt;DesignerService&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- designerRepository: InteriorDesignerRepository&lt;hr&gt;+ requireById(id: Long): InteriorDesigner&lt;br&gt;+ licenseReuseWarning(designerId: Long, licenseNumber: String): String' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="283" y="396" width="435" height="112" as="geometry"/></mxCell><mxCell id="c6" value='&lt;div style="text-align:center"&gt;«Control»&lt;br&gt;&lt;b style="font-size:13px"&gt;LicenseVerificationService&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- entityManager: EntityManager&lt;br&gt;- userAccountRepository: UserAccountRepository&lt;br&gt;- verificationRepository: LicenseVerificationRepository&lt;hr&gt;+ verify(designerId: Long, adminId: Long,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;expectedLicenseNumber: String, expectedCompanyName: String,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;note: String): InteriorDesigner&lt;br&gt;+ revoke(designerId: Long, adminId: Long,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;expectedLicenseNumber: String, expectedCompanyName: String,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;note: String): InteriorDesigner&lt;br&gt;+ hist