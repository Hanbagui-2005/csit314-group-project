<mxfile host="drawio" agent="csit314-diagram-generator" version="24.7.17"><diagram id="PM-07-class" name="PM-07-class"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value='&lt;b style="font-size:16px"&gt;PM-07 · Category designer shortage — Class Diagram&lt;/b&gt;&lt;br&gt;&lt;i&gt;As Platform Management, I want to track which categories have a shortage of active designers relative to customer demand so I can prioritize recruiting designers in underserved categories.&lt;/i&gt;&lt;br&gt;&lt;span style="color:#555555"&gt;Layers: «Boundary» = Spring @Controller · «Control» = @Service · «Entity» = JPA entity / repository / data record&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1413" height="70" as="geometry"/></mxCell><mxCell id="c4" value='&lt;div style="text-align:center"&gt;«Boundary»&lt;br&gt;&lt;b style="font-size:13px"&gt;PlatformManagerController&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- platformReportService: PlatformReportService&lt;hr&gt;+ reports(model: Model): String' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="572" y="110" width="309" height="98" as="geometry"/></mxCell><mxCell id="c5" value='&lt;div style="text-align:center"&gt;«Control»&lt;br&gt;&lt;b style="font-size:13px"&gt;PlatformReportService&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- BOOKINGS_PER_DESIGNER_SHORTAGE_THRESHOLD: double = 3.0&lt;br&gt;- categoryRepository: CategoryRepository&lt;br&gt;- projectRepository: ProjectRepository&lt;br&gt;- bookingRepository: BookingRepository&lt;hr&gt;+ categoryDesignerCoverage(): List&amp;lt;CategoryDesignerCoverage&amp;gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="521" y="288" width="411" height="138" as="geometry"/></mxCell><mxCell id="c6" value='&lt;div style="text-align:center"&gt;«Entity»&lt;br&gt;&lt;b style="font-size:13px"&gt;CategoryRepository&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;+ findByActiveTrue(sort: Sort): List&amp;lt;Category&amp;gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="506" width="299" height="98" as="geometry"/></mxCell><mxCell id="c7" value='&lt;div style="text-align:center"&gt;«Entity»&lt;br&gt;&lt;b style="font-size:13px"&gt;ProjectRepository&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;+ countDistinctActiveDesignersByCategoryId(categoryId: Long): long' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="369" y="506" width="419" height="98" as="geometry"/></mxCell><mxCell id="c8" value='&lt;div style="text-align:center"&gt;«Entity»&lt;br&gt;&lt;b style="font-size:13px"&gt;BookingRepository&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;+ countByProjectCategoryId(categoryId: Long): long' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="838" y="506" width="329" height="98" as="geometry"/></mxCell><mxCell id="c9" value='&lt;div style="text-align:center"&gt;«Entity»&lt;br&gt;«record»&lt;br&gt;&lt;b style="font-size:13px"&gt;CategoryDesignerCoverage&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;categoryId: Long&lt;br&gt;categoryName: String&lt;br&gt;activeDesignerCount: long&lt;br&gt;demandCount: long&lt;br&gt;shortage: boolean&lt;hr&gt;&amp;nbsp;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1217" y="506" width="216" height="166" as="geometry"/></mxCell><mxCell id="c10" value='&lt;div style="text-align:center"&gt;«Entity»&lt;br&gt;&lt;b style="font-size:13px"&gt;Category&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- id: Long&lt;br&gt;- name: String&lt;br&gt;- active: boolean&lt;hr&gt;+ getId(): Long&lt;br&gt;+ getName(): String' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="177" y="752" width="146" height="138" as="geometry"/></mxCell><mxCell id="c11" value='&lt;div style="text-align:center"&gt;«Entity»&lt;br&gt;&lt;b style="font-size:13px"&gt;Project&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- category: Category&lt;br&gt;- designer: InteriorDesigner&lt;hr&gt;&amp;nbsp;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="373" y="752" width="191" height="112" as="geometry"/></mxCell><mxCell id="c12" value='&lt;div style="text-align:center"&gt;«Entity»&lt;br&gt;&lt;b style="font-size:13px"&gt;InteriorDesigner&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- status: AccountStatus&lt;hr&gt;&amp;nbsp;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" pare