<mxfile host="drawio" agent="csit314-diagram-generator" version="24.7.17"><diagram id="ADM-10-class" name="ADM-10-class"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value='&lt;b style="font-size:16px"&gt;ADM-10 · Review complaints against a designer — Class Diagram&lt;/b&gt;&lt;br&gt;&lt;i&gt;As a User Admin, I want to review customer-submitted complaints against a specific designer so I can decide whether to suspend their account.&lt;/i&gt;&lt;br&gt;&lt;span style="color:#555555"&gt;Layers: «Boundary» = Spring @Controller · «Control» = @Service · «Entity» = JPA entity / repository / data record&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1190" height="70" as="geometry"/></mxCell><mxCell id="c4" value='&lt;div style="text-align:center"&gt;«Boundary»&lt;br&gt;&lt;b style="font-size:13px"&gt;AdminInsightsController&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- complaintService: ComplaintService&lt;hr&gt;+ complaints(designerId: Long, model: Model): String&lt;br&gt;+ resolveComplaint(id: Long, redirect: RedirectAttributes): String&lt;br&gt;+ dismissComplaint(id: Long, redirect: RedirectAttributes): String' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="211" y="110" width="406" height="125" as="geometry"/></mxCell><mxCell id="c5" value='&lt;div style="text-align:center"&gt;«Boundary»&lt;br&gt;&lt;b style="font-size:13px"&gt;AdminController&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- userManagementService: UserManagementService&lt;hr&gt;+ suspend(id: Long, redirect: RedirectAttributes): String' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="666" y="110" width="353" height="98" as="geometry"/></mxCell><mxCell id="c6" value='&lt;div style="text-align:center"&gt;«Control»&lt;br&gt;&lt;b style="font-size:13px"&gt;ComplaintService&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- complaintRepository: ComplaintRepository&lt;hr&gt;+ all(): List&amp;lt;Complaint&amp;gt;&lt;br&gt;+ forDesigner(designerId: Long): List&amp;lt;Complaint&amp;gt;&lt;br&gt;+ resolve(complaintId: Long): void&lt;br&gt;+ dismiss(complaintId: Long): void&lt;br&gt;- find(complaintId: Long): Complaint' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="296" y="315" width="308" height="152" as="geometry"/></mxCell><mxCell id="c7" value='&lt;div style="text-align:center"&gt;«Control»&lt;br&gt;&lt;b style="font-size:13px"&gt;UserManagementService&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- userAccountRepository: UserAccountRepository&lt;hr&gt;+ suspend(userId: Long): UserAccount&lt;br&gt;- findAccount(userId: Long): UserAccount' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="653" y="315" width="308" height="112" as="geometry"/></mxCell><mxCell id="c8" value='&lt;div style="text-align:center"&gt;«Entity»&lt;br&gt;&lt;b style="font-size:13px"&gt;ComplaintRepository&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;+ findAllByOrderByCreatedAtDesc(): List&amp;lt;Complaint&amp;gt;&lt;br&gt;+ findByDesignerIdOrderByCreatedAtDesc(designerId: Long): List&amp;lt;Complaint&amp;gt;&lt;br&gt;+ findById(id: Long): Optional&amp;lt;Complaint&amp;gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="183" y="547" width="468" height="125" as="geometry"/></mxCell><mxCell id="c9" value='&lt;div style="text-align:center"&gt;«Entity»&lt;br&gt;&lt;b style="font-size:13px"&gt;UserAccountRepository&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;+ findById(id: Long): Optional&amp;lt;UserAccount&amp;gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="701" y="547" width="278" height="98" as="geometry"/></mxCell><mxCell id="c10" value='&lt;div style="text-align:center"&gt;«Entity»&lt;br&gt;&lt;b style="font-size:13px"&gt;Complaint&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- id: Long&lt;br&gt;- customer: Customer&lt;br&gt;- designer: InteriorDesigner&lt;br&gt;- description: String&lt;br&gt;- status: ComplaintStatus = OPEN&lt;br&gt;- createdAt: LocalDateTime&lt;hr&gt;+ resolve(): void&lt;br&gt;+ dismiss(): void&lt;br&gt;+ getStatus(): ComplaintStatus' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="752" width="226" height="192" as="geometry"/></mxCell><mxCell id="c11" value='&lt;div style="text-align:center"&gt;«Entity»&lt;br&gt;«enumeration»&lt;br&gt;&lt;b style="font-size:13px"&gt;ComplaintStatus&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;OPEN&lt;br&gt;RESOLVED&lt;br&gt;DISMISSED&lt;hr&gt;&amp;nbsp;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" paren