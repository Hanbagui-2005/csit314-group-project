<mxfile host="drawio" agent="csit314-diagram-generator" version="24.7.17"><diagram id="CUS-04-class" name="CUS-04-class"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value='&lt;b style="font-size:16px"&gt;CUS-04 · Filter by room size and budget — Class Diagram&lt;/b&gt;&lt;br&gt;&lt;i&gt;As a Customer, I want to specify my room dimensions and budget range when browsing so results are filtered to projects realistically achievable within my constraints.&lt;/i&gt;&lt;br&gt;&lt;span style="color:#555555"&gt;Layers: «Boundary» = Spring @Controller · «Control» = @Service · «Entity» = JPA entity / repository / data record&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="784" height="70" as="geometry"/></mxCell><mxCell id="c4" value='&lt;div style="text-align:center"&gt;«Boundary»&lt;br&gt;&lt;b style="font-size:13px"&gt;PageController&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- browseService: BrowseService&lt;br&gt;- projectService: ProjectService&lt;hr&gt;+ search(q: String, category: String, minBudget: Integer,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;maxBudget: Integer, roomSize: Integer, verifiedOnly: boolean,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;location: String, model: Model): String' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="194" y="110" width="435" height="138" as="geometry"/></mxCell><mxCell id="c5" value='&lt;div style="text-align:center"&gt;«Control»&lt;br&gt;&lt;b s