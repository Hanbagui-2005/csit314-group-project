<mxfile host="drawio" agent="csit314-diagram-generator" version="24.7.17"><diagram id="ADM-11-class" name="ADM-11-class"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value='&lt;b style="font-size:16px"&gt;ADM-11 · Designer dispute and cancellation rates — Class Diagram&lt;/b&gt;&lt;br&gt;&lt;i&gt;As a User Admin, I want to see which designers have the highest rate of customer disputes or cancellations so I can proactively monitor quality control.&lt;/i&gt;&lt;br&gt;&lt;span style="color:#555555"&gt;Layers: «Boundary» = Spring @Controller · «Control» = @Service · «Entity» = JPA entity / repository / data record&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1162" height="70" as="geometry"/></mxCell><mxCell id="c4" value='&lt;div style="text-align:center"&gt;«Boundary»&lt;br&gt;&lt;b style="font-size:13px"&gt;AdminInsightsController&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- adminInsightsService: AdminInsightsService&lt;hr&gt;+ quality(model: Model): String' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="455" y="110" width="292" height="98" as="geometry"/></mxCell><mxCell id="c5" value='&lt;div style="text-align:center"&gt;«Control»&lt;br&gt;&lt;b style="font-size:13px"&gt;AdminInsightsService&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- designerRepository: InteriorDesignerRepository&lt;br&gt;- complaintRepository: ComplaintRepository&lt;br&gt;- bookingRepository: BookingRepository&lt;hr&gt;+ designerQualitySummaries(): List&amp;lt;DesignerQualitySummary&amp;gt;&lt;br&gt;- summarise(designer: InteriorDesigner): DesignerQualitySummary' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="399" y="288" width="404" height="138" as="geometry"/></mxCell><mxCell id="c6" value='&lt;div style="text-align:center"&gt;«Entity»&lt;br&gt;&lt;b style="font-size:13px"&gt;InteriorDesignerRepository&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;+ findAll(): List&amp;lt;InteriorDesigner&amp;gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="506" width="225" height="98" as="geometry"/></mxCell><mxCell id="c7" value='&lt;div style="text-align:center"&gt;«Entity»&lt;br&gt;&lt;b style="font-size:13px"&gt;ComplaintRepository&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;+ countByDesignerId(designerId: Long): long' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="295" y="506" width="279" height="98" as="geometry"/></mxCell><mxCell id="c8" value='&lt;div style="text-align:center"&gt;«Entity»&lt;br&gt;&lt;b style="font-size:13px"&gt;BookingRepository&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;+ countByDesignerId(designerId: Long): long&lt;br&gt;+ countByDesignerIdAndStatus(designerId: Long,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;status: BookingStatus): long' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="624" y="506" width="305" height="125" as="geometry"/></mxCell><mxCell id="c9" value='&lt;div style="text-align:center"&gt;«Entity»&lt;br&gt;«record»&lt;br&gt;&lt;b style="font-size:13px"&gt;DesignerQualitySummary&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;designer: InteriorDesigner&lt;br&gt;complaintCount: long&lt;br&gt;totalBookings: long&lt;br&gt;cancelledBookings: long&lt;br&gt;disputeRate: Double&lt;br&gt;cancellationRate: Double&lt;hr&gt;&amp;nbsp;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="980" y="506" width="202" height="180" as="geometry"/></mxCell><mxCell id="c10" value='&lt;div style="text-align:center"&gt;«Entity»&lt;br&gt;&lt;b style="font-size:13px"&gt;Complaint&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- designer: InteriorDesigner&lt;br&gt;- status: ComplaintStatus&lt;hr&gt;&amp;nbsp;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="207" y="766" width="191" height="112" as="geometry"/></mxCell><mxCell id="c11" value='&lt;div style="text-align:center"&gt;«Entity»&lt;br&gt;&lt;b style="font-size:13px"&gt;InteriorDesigner&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- contactName: String&lt;br&gt;- company: Company&lt;hr&gt;+ getId(): Long&lt;br&gt;+ getDisplayName(): String' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="447" y="766" width="177" height="125" as="geometry"/></mxCell><mxCell id="c12" value='&lt;div style="text-align:center"&gt;«Entity»&lt;br&gt;&lt;b style="font-size:13px"&gt;Booking&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- designer: InteriorDesigner&lt;br&gt;- status: BookingStatus&lt